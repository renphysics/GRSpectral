Cell[CellGroupData[{

Cell["Example 1: Holographic superconductors in 0803.3295 (HHH)", "Subsection",
 CellChangeTimes->{{3.460908204585561*^9, 3.460908206407299*^9}, {
  3.7406416835879292`*^9, 3.7406416993958263`*^9}, {3.740641933899009*^9, 
  3.740641943339574*^9}, {3.7418006991223836`*^9, 
  3.74180070014456*^9}},ExpressionUUID->"ff9f4f25-dab1-45aa-a49f-\
e5717f735e12"],

Cell[TextData[{
 "We start from the two coupled equations. They are copied from Herzog\
\[CloseCurlyQuote]s ",
 ButtonBox["notebook",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://insti.physics.sunysb.edu/~cpherzog/superconductor/index.html"]\
, None},
  ButtonNote->
   "http://insti.physics.sunysb.edu/~cpherzog/superconductor/index.html"],
 " by the shooting method."
}], "Text",
 CellChangeTimes->{{3.404664273517308*^9, 3.404664427064627*^9}, {
  3.404664461213721*^9, 3.404664477562335*^9}, {3.4609060050249*^9, 
  3.460906006054243*^9}, {3.7406419560272818`*^9, 3.740641985067551*^9}, {
  3.740642643598422*^9, 
  3.740642663985684*^9}},ExpressionUUID->"82122d63-ae2f-46ba-b598-\
4f397b7c5ae6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"restart", "[", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"flist", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"psi", "[", "z", "]"}], ",", 
     RowBox[{"phi", "[", "z", "]"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 

 RowBox[{
  RowBox[{
   RowBox[{"eqlist", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "z"}], "+", 
          SuperscriptBox["z", "4"], "+", 
          SuperscriptBox[
           RowBox[{"phi", "[", "z", "]"}], "2"]}], ")"}], " ", 
        RowBox[{"psi", "[", "z", "]"}]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          SuperscriptBox["z", "3"]}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"3", " ", 
           SuperscriptBox["z", "2"], " ", 
           RowBox[{
            SuperscriptBox["psi", "\[Prime]",
             MultilineFunction->None], "[", "z", "]"}]}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "1"}], "+", 
             SuperscriptBox["z", "3"]}], ")"}], " ", 
           RowBox[{
            SuperscriptBox["psi", "\[Prime]\[Prime]",
             MultilineFunction->None], "[", "z", "]"}]}]}], ")"}]}]}], ",", 
      RowBox[{
       RowBox[{"2", " ", 
        RowBox[{"phi", "[", "z", "]"}], " ", 
        SuperscriptBox[
         RowBox[{"psi", "[", "z", "]"}], "2"]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          SuperscriptBox["z", "3"]}], ")"}], " ", 
        RowBox[{
         SuperscriptBox["phi", "\[Prime]\[Prime]",
          MultilineFunction->None], "[", "z", "]"}]}]}]}], "}"}]}], ";"}], 
  " ", 
  RowBox[{"(*", 
   RowBox[{"Equations", " ", "of", " ", "motion"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"bdylist1", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"psi", "'"}], "[", "z", "]"}], ",", 
      RowBox[{
       RowBox[{"phi", "[", "z", "]"}], "-", "mu"}]}], "}"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Boundary", " ", "conditions", " ", "at", " ", "z"}], "=", "0"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"bdylist2", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"3", 
        SuperscriptBox["z", "2"], 
        RowBox[{
         RowBox[{"psi", "'"}], "[", "z", "]"}]}], "-", 
       RowBox[{"2", 
        RowBox[{"psi", "[", "z", "]"}]}]}], ",", 
      RowBox[{"phi", "[", "z", "]"}]}], "}"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Boundary", " ", "conditions", " ", "at", " ", "z"}], "=", "1"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"eqProcess", "[", 
    RowBox[{"flist", ",", "eqlist", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"z", "==", "0"}], ",", "bdylist1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"z", "==", "1"}], ",", "bdylist2"}], "}"}]}], "}"}]}], "]"}],
    ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Impose", " ", "boundary", " ", "conditions"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"calcfref", ":=", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"psi", "=", "one"}], ";", " ", 
      RowBox[{"phi", "=", 
       RowBox[{"mu", " ", "one"}]}], ";"}], ")"}]}], ";"}], "  ", 
  RowBox[{"(*", 
   RowBox[{"Initial", " ", "guess", " ", "of", " ", "the", " ", "solution"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"output", ":=", 
   RowBox[{"(", "solsave", ")"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.923380448388605*^9, 3.923380492569138*^9}, {
   3.923519127724246*^9, 3.923519130543194*^9}, 3.923918621279834*^9, {
   3.9239187425239*^9, 3.923918774675849*^9}, {3.92624671079207*^9, 
   3.926246794894727*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"e374e6a2-6041-48ff-adab-bc5a0f98abaa"],

Cell[BoxData[
 RowBox[{
  RowBox[{"spNDSolve", "[", 
   RowBox[{"z", ",", 
    RowBox[{"linearMap", "[", 
     RowBox[{"{", 
      RowBox[{"0", ",", "1"}], "}"}], "]"}], ",", "60", ",", 
    RowBox[{"{", 
     RowBox[{"mu", ",", "2"}], "}"}]}], "]"}], ";"}]], "Input",
