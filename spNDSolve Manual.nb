Cell["\<\
epValue: When the change for an iteration is smaller than the epValue, the \
iteration will stop.\
\>", "Item",
 CellChangeTimes->{{3.741344543585189*^9, 3.74134459728094*^9}, {
   3.741344640303876*^9, 3.741344750768185*^9}, 
   3.929691177740139*^9},ExpressionUUID->"dc74d07d-27aa-4a16-86e3-\
80df70c29b3b"],

Cell["\<\
eqlistmatQ: If the equations and there Jacobian are saved to a file, this \
option must be set to be True.\
\>", "Item",
 CellChangeTimes->{{3.741344543585189*^9, 3.74134459728094*^9}, {
  3.741344640303876*^9, 3.741344795870843*^9}, {3.929691078436289*^9, 
  3.929691080157093*^9}},ExpressionUUID->"e9ab49bb-d2ee-4c0d-9aea-\
f39c0640feb8"],

Cell["\<\
iniQ: If this is True, then the initial guess of the solution is given by \
calcfref. If it is False, then not run calcfref.\
\>", "Item",
 CellChangeTimes->{{3.741344543585189*^9, 3.74134459728094*^9}, {
  3.741344640303876*^9, 3.7413448760249586`*^9}, {3.929691112298794*^9, 
  3.929691130674879*^9}},ExpressionUUID->"b7964e7d-f8c5-48fc-8553-\
5cfbf2085691"],

Cell["\<\
linearQ: If the equations are linear, this must be set to be True.\
\>", "Item",
 CellChangeTimes->{{3.741344543585189*^9, 3.74134459728094*^9}, {
  3.741344640303876*^9, 
  3.741344906630303*^9}},ExpressionUUID->"0288cf8a-365e-451f-8365-\
aa98a4588ea1"],

Cell["\<\
lsqrQ: If this is True, then use LeastSquare instead of LinearSolve.\
\>", "Item",
 CellChangeTimes->{{3.741344543585189*^9, 3.74134459728094*^9}, {
   3.741344640303876*^9, 3.741344941309967*^9}, 
   3.9296911740843525`*^9},ExpressionUUID->"4d1b8803-e192-4e33-a951-\
dd3e4be4a315"],

Cell["\<\
minPrec: If it is zero, then use machine precision. If it is nonzero, then \
use specified precision.\
\>", "Item",
 CellChangeTimes->{{3.741344543585189*^9, 3.74134459728094*^9}, {
  3.741344640303876*^9, 3.741344984877699*^9}, {3.929691165442053*^9, 
  3.929691171225706*^9}},ExpressionUUID->"d90d3fb9-2ea9-4f84-8e9f-\
8528d7ab16ad"],

Cell["\<\
\[OpenCurlyDoubleQuote]D\[CloseCurlyDoubleQuote]->n: Delete the rows and \
columns corresponding to boundaries with label n.\
\>", "Item",
 CellChangeTimes->{{3.741344543585189*^9, 3.74134459728094*^9}, {
  3.741344640303876*^9, 3.741345007030886*^9}, {3.741345061638183*^9, 
