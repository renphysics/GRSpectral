Cell[BoxData[{
 RowBox[{
  RowBox[{"restart", "[", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"flist", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"psi", "[", "z", "]"}], ",", 
      RowBox[{"phi", "[", "z", "]"}]}], "}"}]}], ";"}], " ", 
  RowBox[{"(*", 
   StyleBox[
    RowBox[{"unkown", " ", "functions", " ", "to", " ", "be", " ", "solved"}],
    
    FontColor->RGBColor[1, 0, 1]], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"reflist", "=", 
    RowBox[{"{", 
     RowBox[{"f", "[", "z", "]"}], "}"}]}], ";"}], " ", 
  RowBox[{"(*", 
   StyleBox[
    RowBox[{"other", " ", "functions", " ", "in", " ", "equations"}],
    FontColor->RGBColor[1, 0, 1]], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"bdylist1", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"psi", "'"}], "[", "z", "]"}], ",", 
      RowBox[{
       RowBox[{"phi", "[", "z", "]"}], "-", "mu"}]}], "}"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Boundary", " ", "conditions", " ", "at", " ", "z"}], "=", "0"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"bdylist2", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"3", 
        SuperscriptBox["z", "2"], 
        RowBox[{
         RowBox[{"psi", "'"}], "[", "z", "]"}]}], "-", 
       RowBox[{"2", 
        RowBox[{"psi", "[", "z", "]"}]}]}], ",", 
      RowBox[{"phi", "[", "z", "]"}]}], "}"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Boundary", " ", "conditions", " ", "at", " ", "z"}], "=", "1"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"eqProcess", "[", 
    RowBox[{
