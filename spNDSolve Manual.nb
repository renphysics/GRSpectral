  3.9296943649428787`*^9, 
  3.929694393988886*^9}},ExpressionUUID->"d83bfa9e-1dc0-404b-88eb-\
86fa77c2b587"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"restart", "[", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"flist", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"psi", "[", "z", "]"}], ",", 
     RowBox[{"phi", "[", "z", "]"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 

 RowBox[{
  RowBox[{
   RowBox[{"reflist", "=", 
    RowBox[{"{", 
     RowBox[{"f", "[", "z", "]"}], "}"}]}], ";"}], " ", 
  RowBox[{"(*", 
   StyleBox[
    RowBox[{"other", " ", "functions", " ", "in", " ", "equations"}],
    FontColor->RGBColor[1, 0, 1]], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eqlist", "=", 
   RowBox[{"{", 
    RowBox[{
     FractionBox[
      RowBox[{"z", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "z"}], "+", 
            SuperscriptBox["z", "4"], "+", 
            SuperscriptBox[
             RowBox[{"phi", "[", "z", "]"}], "2"]}], ")"}], " ", 
          RowBox[{"psi", "[", "z", "]"}]}], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "1"}], "+", 
            SuperscriptBox["z", "3"]}], ")"}], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"3", " ", 
             SuperscriptBox["z", "2"], " ", 
             RowBox[{
              SuperscriptBox["psi", "\[Prime]",
               MultilineFunction->None], "[", "z", "]"}]}], "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "1"}], "+", 
               SuperscriptBox["z", "3"]}], ")"}], " ", 
             RowBox[{
              SuperscriptBox["psi", "\[Prime]\[Prime]",
               MultilineFunction->None], "[", "z", "]"}]}]}], ")"}]}]}], 
        ")"}]}], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         SuperscriptBox["z", "3"]}], ")"}], "2"]], ",", 
     FractionBox[
      RowBox[{
       RowBox[{"2", " ", 
        RowBox[{"phi", "[", "z", "]"}], " ", 
        SuperscriptBox[
         RowBox[{"psi", "[", "z", "]"}], "2"]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          SuperscriptBox["z", "3"]}], ")"}], " ", 
        RowBox[{
         SuperscriptBox["phi", "\[Prime]\[Prime]",
          MultilineFunction->None], "[", "z", "]"}]}]}], 
      RowBox[{
       RowBox[{"-", "1"}], "+", 
       SuperscriptBox["z", "3"]}]]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eqProcess", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"flist", ",", "reflist"}], "}"}], ",", 
    RowBox[{"put", "[", "eqlist", "]"}]}], "]"}], ";"}]}], "Input",
 CellChangeTimes->{{3.741343843974113*^9, 3.741343884822075*^9}, {
  3.926838029197208*^9, 3.9268380450817747`*^9}, {3.9268382074237*^9, 
